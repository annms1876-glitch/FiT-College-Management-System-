# ---------------------------------------------------------------------------
# Backend (BaaS) — the portal runs on a local driver until these are set.
# Supported driver ids: local | appwrite | pocketbase | supabase
# ---------------------------------------------------------------------------
VITE_BAAS_DRIVER=local
VITE_BAAS_URL=
VITE_BAAS_PROJECT=
# Never commit real keys. For browser SDKs prefer a public/anon key scoped by RLS.
VITE_BAAS_KEY=
